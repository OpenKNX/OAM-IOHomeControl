    "velocet_semantic_reference": "https://github.com/Velocet/iown-homecontrol/blob/b7a526d07506f5192548aadfecf68d0f6e5497fa/docs/commands.md",
    "klf_api_semantic_reference": "https://device.report/m/533a5d7f5adc938b0c19129716e3b64b3d52d913af7da08a4f8376e9a1a3da69.pdf",
    "klf_document": "VELUX API 3.16, printed pp. 44 and 70-71; gateway format is not native RF offsets"
  },
  "implementation": {
    "native_layout": "BE16 bytes6/7 only for qualified owned correlated native main-info 03/04. Request type/parameters, channel, peer, own destination, saved key, product revision and original epoch are required. Short/ACK/tilt/probe/foreign/mismatched responses are excluded.",
    "remaining_semantics": {
      "positive": "1..65533, precise only within remaining bounded interpolation window",
      "zero": "ambiguous; short confirmation only after positive count in the same moving epoch",
      "FFFE": "unbounded, not a precise duration",
      "FFFF": "undefined",
      "unavailable": "short or unsupported reply context"
    },
    "measurements": "Preserve measured current/target and reported motion; restart interpolation from measured current only. STOPPED ends tracking and never snaps endpoints.",
    "cadence": "Only shorten an existing estimate follow-up; unknown countdowns retain normal tracked cadence. Untracked motion reports cannot create an epoch. Preserve normal 2 s default, configured shorter intervals, 10 s low-power floor and original bounded deadline.",
    "moving_grace": "First two actual single-attempt tracked poll misses with qualified measured or authenticated owned moving evidence retain normal cadence. Third enters existing auth/silent ladder; no restart within a real streak. STOP-settle multi-try polls get no grace.",
    "admission": "Local RF/driver/auth-build faults defer within the original epoch with channel fairness and no peer-miss/grace consumption. Existing central CCA and duty policy retained. No new RF exemption, recurring poll configuration, writes, key extraction or SetConfig1 operation."
  },
